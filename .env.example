# ==============================================================================
# AL UMAR PERFUMES & HERITAGE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` and replace the placeholder values.
# ==============================================================================

# Database (Supabase Cloud PostgreSQL)
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth.js
NEXTAUTH_SECRET="your-32-byte-hex-secret-here"
NEXTAUTH_URL="http://localhost:3001"

# Supabase Storage & Client API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Razorpay Payment Gateway (Prepaid)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Resend Transactional Email Service
RESEND_API_KEY="re_xxxxxxxxxxxxxx"

# Admin Security & Credentials
ADMIN_EMAIL="alumar8080@gmail.com"
ADMIN_PASSWORD_HASH="your-bcrypt-password-hash"
ADMIN_BASE_PATH="/admin8080"
ADMIN_ALLOWED_IPS="127.0.0.1,::1"
TOTP_ENCRYPTION_KEY="your-64-character-hex-encryption-key"

# Public Analytics & SEO
NEXT_PUBLIC_GA_ID="G-ALUMAR2026"
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
NEXT_PUBLIC_SITE_URL="https://alumarperfumes.com"

# Shiprocket Logistics Integration (apidocs.shiprocket.in)
# Register at https://app.shiprocket.in -> Settings -> API -> Configure
SHIPROCKET_EMAIL="your-shiprocket-registered-email@example.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE="400001"

# Automated Tracking Cron Secret (Bearer token for /api/cron/sync-tracking)
CRON_SECRET="your_long_random_cron_secret_key"

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID="your_meta_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_permanent_token"
